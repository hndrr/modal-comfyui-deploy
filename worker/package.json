  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/three": "0.180.0",
    "esbuild": "0.28.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.157.0"
  }
