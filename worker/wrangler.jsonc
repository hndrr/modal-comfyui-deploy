{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comfyui-access-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",

  // カスタムドメイン以外の入口を塞ぐ。外すと Cloudflare Access を迂回できる経路が復活する。
  // docs/design/cloudflare-access.md「迂回経路を塞ぐ」を参照。
  "workers_dev": false,
  "preview_urls": false,

  "observability": {
    "enabled": true
  }

  // このファイルには環境固有の値を一切書かない（リポジトリを公開できるようにするため）。
  //
  // - 接続先ホスト名は Cloudflare ダッシュボードの
  //   Workers & Pages → comfyui-access-proxy → Settings → Domains & Routes
  //   で Custom Domain として登録する。
  //   `routes` キーを持たない設定ファイルはダッシュボード側の設定を上書きしない。
  //
  // - MODAL_ORIGINS / TEAM_DOMAIN / POLICY_AUD / MODAL_KEY / MODAL_SECRET は
  //   すべて `wrangler secret put <NAME>` で登録する。secret は Cloudflare 側に
  //   保存され、設定ファイルに書かれていなくてもデプロイで消えない。
  //
  // - ローカルの `wrangler dev` では .dev.vars（gitignore 済み）から読む。
  //
  // 詳細は docs/cloudflare-access.md を参照。
}
