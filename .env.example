COMFYUI_GPU_PROFILE=rtx-pro-6000
COMFYUI_SAGE_ATTENTION=on
COMFYUI_SCALEDOWN_WINDOW=30
COMFYUI_FUNCTION_TIMEOUT=1800
COMFYUI_CLI_ARGS=
COMFYUI_FORCE_BUILD=on
# Cloudflare Access + Worker 構成で使う場合は on にする（docs/cloudflare-access.md）
COMFYUI_REQUIRES_PROXY_AUTH=off
# ComfyUI Manager からのノードインストールを許可する場合は on
# （URL を開ける人が任意のコードを入れられる状態になる。docs/comfyui-modal.md）
COMFYUI_MANAGER_INSTALL=off
COMFY_ASSET_LEASE_MAX_BYTES=8589934592
COMFY_ASSET_LEASE_MAX_FILES=32
HF_TOKEN=

# Split: all integrations are optional. Empty lists mean a standalone deployment.
SPLIT_EXTENSIONS=
SPLIT_NODE_PACKS=
SPLIT_AGENT_BRIDGE=off
# Optional integrations: SPLIT_EXTENSIONS=ambient
# Node packs (comma-separated): agent-bridge,agent-runtime,skills-loader,gemini,jev
# Bridge is independently enabled by SPLIT_AGENT_BRIDGE=on.
# Verification scripts use the split CPU endpoint, regardless of Ambient usage.
SPLIT_URL=
# Old COMFYUI_AMBIENT_MODE=on remains a fallback only for unspecified new settings.
# 任意のAmbient拡張・Bridge中継・privateノードの取得用。Modal Secret内に GITHUB_TOKEN を設定する。
# 利用する hndrr/ComfyUI-Ambient / ComfyUI-AgentBridge と選択ノードrepoのread権限が必要。
GITHUB_SECRET_NAME=github-secret
# 使うサービスのModal Secret名だけ設定する（空欄は未使用）。キー本体はModalに保存。
# 例: GEMINI_SECRET_NAME=gemini-secret（Secret内に GEMINI_API_KEY を設定）
GEMINI_SECRET_NAME=gemini-secret
TYPESAFE_SECRET_NAME=typesafe-secret
OPENROUTER_SECRET_NAME=openrouter-secret
# Bridgeを使う場合: agent-runtime-secret（Secret内に AGENT_RUNTIME_BRIDGE_TOKEN を設定）
AGENT_RUNTIME_SECRET_NAME=agent-runtime-secret
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
# Standard comfyapp only; splitapp pins COMFY_REVISION in splitapp.py instead.
# Exact ComfyUI Git SHA; blank preserves the existing install path.
COMFYUI_REVISION=
