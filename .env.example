COMFYUI_GPU_PROFILE=rtx-pro-6000
COMFYUI_SAGE_ATTENTION=on
COMFYUI_SCALEDOWN_WINDOW=30
COMFYUI_FUNCTION_TIMEOUT=1800
COMFYUI_CLI_ARGS=
COMFYUI_FORCE_BUILD=on
# Cloudflare Access + Worker 構成で使う場合は on にする（docs/operations/cloudflare-access.md）
COMFYUI_REQUIRES_PROXY_AUTH=off
# ComfyUI Manager からのノードインストールを許可する場合は on
# （URL を開ける人が任意のコードを入れられる状態になる。docs/guides/comfyui-modal.md）
COMFYUI_MANAGER_INSTALL=off
COMFY_ASSET_LEASE_MAX_BYTES=8589934592
COMFY_ASSET_LEASE_MAX_FILES=32
HF_TOKEN=

# Split: all integrations are optional. Empty lists mean a standalone deployment.
# The catalog includes private repositories; enable only sources you can read.
# Keep these defaults for standalone use; no GitHub Secret is required.
SPLIT_EXTENSIONS=
SPLIT_NODE_PACKS=
SPLIT_AGENT_BRIDGE=off
# Optional: Modal Secret NAME containing COMFY_API_KEY. Only the GPU receives the key.
SPLIT_COMFY_BILLING_SECRET=
# Displayed to the owner before billing Comfy credits. Defaults to the Secret name.
SPLIT_COMFY_BILLING_LABEL=
# Optional display labels for direct providers; default to each configured Secret name.
SPLIT_GEMINI_BILLING_LABEL=
SPLIT_OPENROUTER_BILLING_LABEL=
# Extension names and pinned sources: comfy_split/extension_catalog.toml
# Node packs (comma-separated): agent-bridge,agent-runtime,skills-loader,gemini,jev
# Bridge is independently enabled by SPLIT_AGENT_BRIDGE=on.
# 任意拡張の取得・認証設定は docs/guides/split-integrations.md を参照。
# scripts/verify_cpu_snapshot.py uses this split CPU endpoint.
SPLIT_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
# Optional split override: full lowercase Git SHA; blank selects GitHub's Latest stable release.
SPLIT_COMFYUI_REVISION=
# Standard comfyapp only.
# Exact ComfyUI Git SHA; blank preserves the existing install path.
COMFYUI_REVISION=
